# Application
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=pingwatch
MYSQL_PASSWORD=pingwatch
MYSQL_DATABASE=pingwatch
PING_INTERVAL=30
PING_TIMEOUT=2.0
PING_CONCURRENCY=40
HISTORY_KEEP_DAYS=31
WARNING_RTT_MS=200
DNS_CACHE_TTL=300
SECRET_KEY=pingwatch-dev-secret-change-me

# Docker / Podman Compose interpolation (optional)
MYSQL_ROOT_PASSWORD=pingwatch
MYSQL_PUBLISH_PORT=3307
APP_BIND=0.0.0.0
APP_PORT=8000
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Password@123
PINGWATCH_VERSION=1.2.0
# Uncomment to pull the published image instead of building:
# PINGWATCH_IMAGE=superstackinc/pingwatch:1.2.0
